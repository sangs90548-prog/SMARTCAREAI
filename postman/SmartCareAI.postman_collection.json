		{
			"name": "2. Authentication",
			"item": [
				{
					"name": "User Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.token) {",
									"        pm.collectionVariables.set('authToken', res.data.token);",
									"        console.log('Registered and saved authToken.');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"David Miller\",\n    \"email\": \"david.miller@example.com\",\n    \"password\": \"SecurePass2026!\",\n    \"age\": 29,\n    \"gender\": \"Male\",\n    \"blood_type\": \"B+\",\n    \"phone\": \"+1 (555) 789-0123\",\n    \"emergency_contact\": \"+1 (555) 911-0088\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					},
					"response": []
				},
